#!/usr/bin/env bash

set -euo pipefail

MSG_FILE="$1"
GIT_DIR="$(git rev-parse --git-dir)"
BRANCH="$(git rev-parse --abbrev-ref HEAD)"

## commit rifiutato: la versione torna quella dell'ultimo commit
#
# pre-commit scrive _etc/_current.version e lo mette in stage PRIMA che le guardie qui sotto
# leggano il messaggio; se il commit si rifiuta, il file resterebbe cambiato senza nessun commit
# dietro, e il primo commit o push successivo pubblicherebbe ai deploy una versione che non
# corrisponde a niente. La versione cambia solo insieme a un commit: qui la si rimette com'era
rifiuta() {
    if git cat-file -e HEAD:_etc/_current.version 2> /dev/null; then
        git show HEAD:_etc/_current.version > _etc/_current.version
        git reset -q HEAD -- _etc/_current.version
    fi
    exit 1
}

## guardia dei test, su ogni branch
#
# un commit che tocca il codice porta i suoi test, o dichiara perche' non li porta con una riga
# "Senza-test: <motivo>" ( regola di Fabio del 28/10/2026, vedi _src/_sh/_test.guardia.sh ); i
# merge si saltano, i loro commit sono gia' passati di qui
if [ ! -f "$GIT_DIR/MERGE_HEAD" ]; then
    if ! SENZA="$( bash _src/_sh/_test.guardia.sh --staged "$MSG_FILE" )"; then
        echo "commit rifiutato: tocca il codice senza toccare nessun test" >&2
        echo "$SENZA" | sed 's/^/    /' >&2
        echo "aggiungi il test ( _usr/_test/, _mod/<modulo>/_usr/_test/, _usr/_examples/ ) oppure" >&2
        echo "dichiara nel messaggio 'Senza-test: <motivo>' e apri la voce nel TODO.md, area test automatici" >&2
        rifiuta
    fi
fi

## guardia delle patch, su ogni branch
#
# un commit che cambia lo schema nei file base porta la sua patch datata, o dichiara perche' non la
# porta con una riga "Senza-patch: <motivo>" ( regola di Fabio del 04/11/2026, vedi
# _src/_sh/_patch.guardia.sh ): ai database gia' installati i file base non arrivano mai
if [ ! -f "$GIT_DIR/MERGE_HEAD" ]; then
    if ! SENZA="$( bash _src/_sh/_patch.guardia.sh --staged "$MSG_FILE" )"; then
        echo "commit rifiutato: cambia lo schema nei file base senza una patch datata" >&2
        echo "$SENZA" | sed 's/^/    /' >&2
        echo "aggiungi la patch _usr/_database/_patch/_AAAAMMGGHHMM.<descrizione>.sql oppure, se lo schema" >&2
        echo "non cambia, dichiara nel messaggio 'Senza-patch: <motivo>' ( _usr/_docs/_read/300.database.md )" >&2
        rifiuta
    fi
fi

if [ "$BRANCH" != "master" ]; then
    exit 0
fi

RAW_MSG="$(sed '/^#/d' "$MSG_FILE" | sed '/^[[:space:]]*$/d' | head -n 1 || true)"

if [ -z "$RAW_MSG" ]; then
    RAW_MSG="Aggiornamento"
fi

if [[ "$RAW_MSG" == *"§"* ]]; then
    TITOLO="${RAW_MSG%%§*}"
    TESTO="${RAW_MSG#*§}"
else
    TITOLO="$RAW_MSG"
    TESTO=""
fi

TITOLO="$(printf '%s' "$TITOLO" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
TESTO="$(printf '%s' "$TESTO" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"

jq -n \
  --arg titolo "$TITOLO" \
  --arg testo "$TESTO" \
  '{
    titolo: $titolo,
    testo: $testo
  }' > "$GIT_DIR/changelog_pending.json"

exit 0
