#!/usr/bin/env bash

set -euo pipefail

MSG_FILE="$1"
GIT_DIR="$(git rev-parse --git-dir)"
BRANCH="$(git rev-parse --abbrev-ref HEAD)"

## guardia dei test, su ogni branch
#
# un commit che tocca il codice porta i suoi test, o dichiara perche' non li porta con una riga
# "Senza-test: <motivo>" ( regola di Fabio del 28/10/2026, vedi _src/_sh/_test.guardia.sh ); i
# merge si saltano, i loro commit sono gia' passati di qui
if [ ! -f "$GIT_DIR/MERGE_HEAD" ]; then
    if ! SENZA="$( bash _src/_sh/_test.guardia.sh --staged "$MSG_FILE" )"; then
        echo "commit rifiutato: tocca il codice senza toccare nessun test" >&2
        echo "$SENZA" | sed 's/^/    /' >&2
        echo "aggiungi il test ( _usr/_test/, _mod/<modulo>/_usr/_test/, _usr/_examples/ ) oppure" >&2
        echo "dichiara nel messaggio 'Senza-test: <motivo>' e apri la voce nel TODO.md, area test automatici" >&2
        exit 1
    fi
fi

if [ "$BRANCH" != "master" ]; then
    exit 0
fi

RAW_MSG="$(sed '/^#/d' "$MSG_FILE" | sed '/^[[:space:]]*$/d' | head -n 1 || true)"

if [ -z "$RAW_MSG" ]; then
    RAW_MSG="Aggiornamento"
fi

if [[ "$RAW_MSG" == *"§"* ]]; then
    TITOLO="${RAW_MSG%%§*}"
    TESTO="${RAW_MSG#*§}"
else
    TITOLO="$RAW_MSG"
    TESTO=""
fi

TITOLO="$(printf '%s' "$TITOLO" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
TESTO="$(printf '%s' "$TESTO" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"

jq -n \
  --arg titolo "$TITOLO" \
  --arg testo "$TESTO" \
  '{
    titolo: $titolo,
    testo: $testo
  }' > "$GIT_DIR/changelog_pending.json"

exit 0
