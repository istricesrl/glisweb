{
    "name": "istricesrl/glisweb",
    "description": "GlisWeb framework for web developement",
    "config": {
        "vendor-dir": "_src/_lib/_ext",
        "platform": {
            "php": "7.3.31"
        }
    },
    "require": {
        "php": ">=7.3",
        "phpoffice/phpword": "*",
        "phpoffice/phpspreadsheet": "*",
        "phpoffice/phppresentation": "*",
        "html2text/html2text": "*",
        "phpmailer/phpmailer": "6.*",
        "tecnickcom/tcpdf": "*",
        "twig/twig": "2.*",
        "predis/predis": "*",
        "codeception/codeception": "*",
        "codeception/module-phpbrowser": "*",
        "codeception/module-asserts": "*"
    },
    "suggest": {
        "twig/extra-bundle": "*"
    }
}
