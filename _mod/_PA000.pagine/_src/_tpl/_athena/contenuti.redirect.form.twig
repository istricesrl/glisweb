{# IMPORTAZIONE LIBRERIE #}
{% import '_lib/_default.twig' as cms %}
{% import '_lib/_form.twig' as frm %}
{% import 'lib/default.twig' as def %}

{# ESTENSIONE DELLO SCHEMA DI BASE #}
{% extends 'ext/main.twig' %}

{# BLOCCO PRINCIPALE DELLA PAGINA #}
{% block main %}
<!-- blocco {{ _self }}::main -->

{# MODULO PRINCIPALE #}
<section class="row flex-fill">
    <div class="col-md-12 d-flex flex-column">

        {# APERTURA DEL FORM #}
        {{ frm.openForm({ 'form': form, 'page': page, 'session': session, 'request': request }) }}

            {# SEZIONE GENERALE #}
            <fieldset>
                <legend>dati generali <small>{{ legend }}</small></legend>

                <div class="form-group row">
                    <div class="col-12 col-md-auto form-col">
                        <span class="label-top">sito</span>
                        {{ frm.select({ 'field': { 'name': 'id_sito' }, 'source': { 'values': etc.select.siti }, 'request': request, 'form': form, 'page': page, 'pages': pages }) }}
                    </div>
                    <div class="col form-col">
                        <span class="label-top">codice http</span>
                        {{ frm.input({ 'field': { 'name': 'codice_stato_http', 'type': 'text' }, 'request': request, 'form': form, 'page': page }) }}
                    </div>
                    <div class="col form-col">
                        <span class="label-top">sorgente</span>
                        {{ frm.input({ 'field': { 'name': 'sorgente', 'type': 'text' }, 'request': request, 'form': form, 'page': page }) }}
                    </div>
                </div>

                <div class="form-group row">

                    <div class="col form-col">
                        <span class="label-top">destinazione</span>
                        {{ frm.input({ 'field': { 'name': 'destinazione', 'type': 'text' }, 'request': request, 'form': form, 'page': page }) }}
                    </div>
                </div>

            </fieldset>

            {# SEZIONE ELABORAZIONE #}
            <fieldset>
                <legend>flag</legend>

                <div class="form-group row">
                    <div class="col-auto col-form-label form-col">
                        <div class="form-check">
                            {{ frm.checkbox({ 'field': { 'name': 'se_query_string', 'placeholder': 'query string' }, 'request': request, 'form': form, 'page': page }) }}
                        </div>
                    </div>
                </div>

            </fieldset>

            {# BOTTONI E COMANDI DEL MODULO #}
            <fieldset class="form-controls mt-auto">
                {{ def.controls( page, pages, ietf, session, form.table, request ) }}
            </fieldset>

        </form>
    </div>
</section>

<!-- fine blocco {{ _self }}::main -->
{% endblock main %}
