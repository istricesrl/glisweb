{% import '_lib/_form.twig' as frm %}

<script>
    function esporta_per_lista() {
        var lista = $( '#__export_____lista__' ).val();
        window.open( '/print/ML000.mailing/lista.csv?__lista__=' + encodeURIComponent( lista ), '_self' );
        bootstrap.Modal.getOrCreateInstance( document.getElementById( 'esporta_per_lista' ) ).hide();
    }
</script>

<div class="modal" tabindex="-1" role="dialog" id="esporta_per_lista">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">esporta iscritti di una lista</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div class="form-row">
                        <div class="col">
                            <label>lista</label>
                            {{ frm.select({ 'field': { 'name': '__lista__', 'required': 1 }, 'source': { 'values': etc.select.liste }, 'form': { 'table': '__export__' }, 'page': page, 'pages': pages }) }}
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="col">
                            gli indirizzi che hanno revocato il consenso non vengono esportati
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" onclick="esporta_per_lista();">esporta</button>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">annulla</button>
            </div>
        </div>
    </div>
</div>
