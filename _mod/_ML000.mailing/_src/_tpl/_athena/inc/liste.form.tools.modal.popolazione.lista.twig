{% import '_lib/_form.twig' as frm %}

<script>
    function popola_lista() {
        var categoria = $( '#__popola_____categoria__' ).val();
        getws( '/task/ML000.mailing/lista.popola.categoria?__categoria__=' + categoria + '&__lista__={{ request[ form.table ].id }}', [], function( data ) {
            console.log( data );
            bootstrap.Modal.getOrCreateInstance( document.getElementById( 'popola_lista' ) ).hide();
            location.reload();
        });
    }
</script>

<div class="modal" tabindex="-1" role="dialog" id="popola_lista">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">popola la lista da una categoria</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div class="form-row">
                        <div class="col">
                            <label>categoria di anagrafica</label>
                            {{ frm.select({ 'field': { 'name': '__categoria__', 'required': 1 }, 'source': { 'values': etc.select.categorie_anagrafica }, 'form': { 'table': '__popola__' }, 'page': page, 'pages': pages }) }}
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="col">
                            gli indirizzi delle anagrafiche della categoria vengono iscritti alla lista, tranne quelli che hanno revocato il consenso; chi è già iscritto resta com'è
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" onclick="popola_lista();">popola</button>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">annulla</button>
            </div>
        </div>
    </div>
</div>
