{% import '_lib/_form.twig' as frm %}

<script>
    function importa_iscritti_mailchimp() {
        var file = $( '#__upload_mc_____iscritti__' ).val();
        var lista = $( '#__mailchimp_____lista__' ).val();
        getws( '/task/ML000.mailing/importazione.iscritti.mailchimp.start?file=' + encodeURIComponent( file ) + '&lista=' + encodeURIComponent( lista ), [], function( data ) {
            console.log( data );
            bootstrap.Modal.getOrCreateInstance( document.getElementById( 'importa_iscritti_mailchimp' ) ).hide();
            location.reload();
        });
    }
</script>

<div class="modal" tabindex="-1" role="dialog" id="importa_iscritti_mailchimp">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">importa iscritti da MailChimp</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div class="form-row">
                        <div class="col">
                            {{ frm.uploader({ 'field': { 'name': '__iscritti__' }, 'form': { 'table': '__upload_mc__' }, 'destination': { 'folder': 'var/contenuti/upload/' }, 'page': page, 'pages': pages, 'site': site }) }}
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="col">
                            <label>lista in cui iscrivere gli indirizzi</label>
                            {{ frm.select({ 'field': { 'name': '__lista__', 'required': 1 }, 'source': { 'values': etc.select.liste }, 'form': { 'table': '__mailchimp__' }, 'page': page, 'pages': pages }) }}
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" onclick="importa_iscritti_mailchimp();">importa</button>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">annulla</button>
            </div>
        </div>
    </div>
</div>
