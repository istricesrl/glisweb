{# IMPORTAZIONE LIBRERIE #}
{% import '_lib/_default.twig' as cms %}
{% import '_lib/_form.twig' as frm %}
{% import 'lib/default.twig' as def %}

{# ESTENSIONE DELLO SCHEMA DI BASE #}
{% extends 'ext/main.twig' %}

{# BLOCCO PRINCIPALE DELLA PAGINA #}
{% block main %}
<!-- blocco {{ _self }}::main -->

{# MODULO PRINCIPALE #}
<section class="row flex-fill">
    <div class="col-md-12 d-flex flex-column">

        {# APERTURA DEL FORM #}
        {{ frm.openForm({ 'form': form, 'page': page, 'session': session, 'request': request }) }}

            {# SEZIONE GENERALE #}
            <fieldset>
                <legend>dati generali <small>{{ legend }}</small></legend>

                {# PRIMA RIGA DI CAMPI #}
                <div class="form-group row">
                    <div class="col-12 col-md form-col">
                        <span class="label-top">genitore</span>
                        {{ frm.select({ 'field': { 'name': 'id_genitore' }, 'source': { 'values': etc.select.genitori }, 'request': request, 'form': form, 'page': page, 'pages': pages }) }}
                    </div>
                    <div class="col-12 col-md-3 form-col">
                        <span class="label-top">codice</span>
                        {{ frm.input({ 'field': { 'name': 'codice', 'type': 'text' }, 'request': request, 'form': form, 'page': page }) }}
                    </div>
                    <div class="col-12 col-md form-col">
                        <span class="label-top">nome</span>
                        {{ frm.input({ 'field': { 'name': 'nome', 'type': 'text' }, 'request': request, 'form': form, 'page': page }) }}
                    </div>
                    <div class="col-12 col-md-2 form-col">
                        <span class="label-top">ordine</span>
                        {{ frm.input({ 'field': { 'name': 'ordine', 'type': 'number' }, 'request': request, 'form': form, 'page': page }) }}
                    </div>
                </div>

            </fieldset>

            {# SEZIONE FLAG #}
            <fieldset>
                <legend>assegnabile a</legend>

                <div class="form-group row">
                    <div class="col-auto col-form-label form-col">
                        <div class="form-check">
                            {{ frm.checkbox({ 'field': { 'name': 'se_prodotti', 'placeholder': 'prodotti' }, 'request': request, 'form': form, 'page': page }) }}
                        </div>
                    </div>
                    <div class="col-auto col-form-label form-col">
                        <div class="form-check">
                            {{ frm.checkbox({ 'field': { 'name': 'se_articoli', 'placeholder': 'articoli' }, 'request': request, 'form': form, 'page': page }) }}
                        </div>
                    </div>
                </div>

            </fieldset>

            {# BOTTONI E COMANDI DEL MODULO #}
            <fieldset class="form-controls mt-auto">
                {{ def.controls( page, pages, ietf, session, form.table, request ) }}
            </fieldset>

        </form>
    </div>
</section>

<!-- fine blocco {{ _self }}::main -->
{% endblock main %}
