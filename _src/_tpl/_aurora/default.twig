{# LIBRERIE #}
{% import '_lib/_default.twig' as cms %}

{# SCHEMA ESTESO #}
{% extends "ext/main.twig" %}

{# BLOCCO MAIN #}
{% block main %}
<!-- blocco {{ _self }}::main -->
<h1>{{ include( template_from_string( page.h1[ localization.language.ietf ]|default('') ) | raw ) }}</h1>
{% if page.h2[ localization.language.ietf ] %}<h2>{{ include( template_from_string( page.h2[ localization.language.ietf ]|default('') ) | raw ) }}</h2>{% endif %}
<div>{{ include( template_from_string( page.content[ localization.language.ietf ]|default('') ) | raw ) }}</div>
<!-- fine blocco {{ _self }}::main -->
{% endblock main %}

{# BLOCCO JAVASCRIPT #}
{# NOTA: dal 2026-09-21 il javascript della pagina lo emette il blocco del layout ext/main.twig,
   che include _inc/_page.javascript.twig: e' lo stesso comportamento di prima, ma vale per tutti
   i template e non solo per questo. Qui non serve piu' sovrascrivere il blocco. #}
