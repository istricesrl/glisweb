{# LIBRERIE #}
{% import '_lib/_default.twig' as cms %}
{% import '_lib/_translation.twig' as trn %}

{# SCHEMA ESTESO #}
{% extends "ext/main.twig" %}

{# BLOCCO MAIN #}
{% block main %}
<!-- blocco {{ _self }}::main -->
<div class="row no-gutters flex-fill align-items-center justify-content-center">
    <form action="{{ page.path[ localization.language.ietf ] }}" class="draggable-item col-12 col-md-6 form-login" id="formReset" method="post">
        <input type="hidden" name="pg" value="{{ page.id }}">
        <fieldset>
            <legend>{{ trn.trw({ 'w': 'richiedi_cambio_password', 'l': localization.language.ietf, 'v': tr.generic, 'd': 'richiedi il cambio password' }) }}</legend>
            {% if request.__pwreset__.__ok__ %}
            <div class="form-group form-row">
                <div class="col-12 text-center col-form-static">{{ request.__pwreset__.__ok__.testo[ localization.language.ietf ] | raw }}</div>
            </div>
            {% elseif request.__pwreset__.__tk_sent__ %}
            <div class="form-group form-row">
                <div class="col-12 text-center col-form-static">{{ request.__pwreset__.__tk_sent__.testo[ localization.language.ietf ] | raw }}</div>
            </div>
            {% elseif request.__pwreset__.__tk_ok__ %}
            <input type="hidden" name="tk" value="{{ request.tk }}">
            <div class="form-group form-row">
                <label class="d-none d-md-block col-md-4 col-form-label">{{ trn.trw({ 'w': 'password', 'l': localization.language.ietf, 'v': tr.generic, 'd': 'password' }) }}</label>
                <div class="col-12 col-md-8"><input type="password" class="form-control form-control-sm" name="__pwreset__[password]" value="{{ request.__pwreset__.password }}" placeholder="{{ trn.trw({ 'w': 'nuova_password', 'l': localization.language.ietf, 'v': tr.generic, 'd': 'la nuova password' }) }}" required></div>
            </div>
            <div class="form-group form-row">
                <div class="col-12"><button type="submit" class="btn btn-secondary btn-sm btn-block">richiedi cambio password</button></div>
            </div>
            {% else %}
            {% if request.__pwreset__.__err__ %}
            <div class="form-group form-row">
                <div class="col-12 text-center col-form-static">{{ request.__pwreset__.__err__.testo[ localization.language.ietf ] | raw }}</div>
            </div>
            {% endif %}
            <div class="form-group form-row">
                <label class="d-none d-md-block col-md-4 col-form-label">{{ trn.trw({ 'w': 'email', 'l': localization.language.ietf, 'v': tr.generic, 'd': 'e-mail' }) }}</label>
                <div class="col-12 col-md-8"><input type="email" class="form-control form-control-sm" name="__pwreset__[email]" value="{{ request.__pwreset__.email }}" placeholder="{{ trn.trw({ 'w': 'la_tua_mail', 'l': localization.language.ietf, 'v': tr.generic, 'd': 'la tua e-mail' }) }}" required></div>
            </div>
            <div class="form-group form-row">
                <div class="col-12">{{ cms.formButton( { 'field': { 'text': trn.trw({ 'w': 'richiedi_cambio_password', 'l': localization.language.ietf, 'v': tr.generic, 'd': 'richiedi cambio password' }) }, 'form': { 'id': 'formReset', 'table': '__pwreset__' }, 'recaptcha': google.profile.recaptcha } ) }}</div>
            </div>
            {% endif %}
            <div class="form-group form-row">
                <div class="col-12"><a href="{{ pages[ site.home ].path[ localization.language.ietf ] }}" class="btn btn-light btn-sm btn-block">{{ trn.trw({ 'w': 'torna_alla_home', 'l': localization.language.ietf, 'v': tr.generic, 'd': 'torna alla home page' }) }}</a></div>
            </div>
        </fieldset>
    </form>
</div>
<!-- fine blocco {{ _self }}::main -->
{% endblock %}
