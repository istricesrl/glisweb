{# LIBRERIE #}
{% import '_lib/_default.twig' as cms %}

{# CAROSELLO DELLE IMMAGINI DI TESTATA
    Le immagini col ruolo carousel scorrono da sole ogni 3,5 secondi ( carousel di Bootstrap 5 ); le frecce e gli
    indicatori compaiono solo se le immagini sono più di una. Titolo, sottotitolo e cappello dell'immagine diventano la
    didascalia; se l'immagine ha il metadato link diventa un collegamento. La libreria _default.twig non ha una macro
    per il carosello, quindi il markup è qui e le singole immagini le disegna cms.image(). #}
<!-- file {{ _self }} -->
{% if page.contents.images.carousel|length > 0 %}
<div id="carousel-main" class="carousel slide carousel-main" data-bs-ride="carousel" data-bs-interval="3500">
    {% if page.contents.images.carousel|length > 1 %}
    <div class="carousel-indicators">
        {% for ordine, img in page.contents.images.carousel %}
        <button type="button" data-bs-target="#carousel-main" data-bs-slide-to="{{ loop.index0 }}"{% if loop.first %} class="active" aria-current="true"{% endif %} aria-label="{{ loop.index }}"></button>
        {% endfor %}
    </div>
    {% endif %}
    <div class="carousel-inner">
        {% for ordine, img in page.contents.images.carousel %}
        <div class="carousel-item{% if loop.first %} active{% endif %}">
            {% if img.metadati.link %}<a href="{{ img.metadati.link[ localization.language.ietf ] }}"{% if img.metadati.target %} target="{{ img.metadati.target }}"{% endif %}>{% endif %}
            {{ cms.image( { 'source': { 'ruolo': 'carousel', 'ordine': ordine, 'ietf': localization.language.ietf }, 'site': site, 'page': page, 'image': image } ) }}
            {% if img.h1[ localization.language.ietf ] or img.h2[ localization.language.ietf ] or img.cappello[ localization.language.ietf ] %}
            <div class="carousel-caption">
                {% if img.h1[ localization.language.ietf ] %}<h1>{{ img.h1[ localization.language.ietf ]|raw }}</h1>{% endif %}
                {% if img.h2[ localization.language.ietf ] %}<h2>{{ img.h2[ localization.language.ietf ]|raw }}</h2>{% endif %}
                {% if img.cappello[ localization.language.ietf ] %}<p>{{ img.cappello[ localization.language.ietf ]|raw }}</p>{% endif %}
            </div>
            {% endif %}
            {% if img.metadati.link %}</a>{% endif %}
        </div>
        {% endfor %}
    </div>
    {% if page.contents.images.carousel|length > 1 %}
    <button class="carousel-control-prev" type="button" data-bs-target="#carousel-main" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">precedente</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carousel-main" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">successiva</span>
    </button>
    {% endif %}
</div>
{% endif %}
<!-- fine file {{ _self }} -->
