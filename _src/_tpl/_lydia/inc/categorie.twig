{# LIBRERIE #}
{% import '_lib/_navigation.twig' as nav %}
{% import '_lib/_default.twig' as cms %}

<!-- file {{ _self }} -->
<div class="col-auto col-md d-flex flex-column">
    {% if page.template.menu.categorie %}
    <nav class="navbar navbar-expand-md navbar-megamenu navbar-light mt-auto mb-auto">
        <button class="navbar-toggler me-auto" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavCat">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNavCat">
            <ul class="navbar-nav me-auto">
                {{ nav.menu( page.template.menu.categorie, localization.language.ietf ) }}
            </ul>
        </div>
    </nav>
    {% endif %}
</div>
<!-- fine file {{ _self }} -->
