{# FILE PER LA GESTIONE DEL CONTROLLO DELLE E-MAIL CON EMAILABLE #}

<script>
async function verificaEmailCampo(idCampo) {

    const apiKey = "{{ emailable.profile.apikey }}";

    const campo = document.getElementById(idCampo);

    if (!campo) {
        throw new Error('Campo non trovato: ' + idCampo);
    }

    const email = campo.value.trim();

    if (!email) {
        return {
            valida: false,
            messaggio: 'Email vuota',
            dati: null
        };
    }

    const url = new URL('https://api.emailable.com/v1/verify');
    url.searchParams.set('email', email);
    url.searchParams.set('api_key', apiKey);
    url.searchParams.set('timeout', '5');

    try {
        const response = await fetch(url.toString());
        const data = await response.json();

        // 249 = verifica lenta, la documentazione consiglia di riprovare
        if (response.status === 249) {
            return {
                valida: false,
                riprovare: true,
                messaggio: 'Verifica troppo lenta, riprovare tra poco',
                dati: data
            };
        }

        if (!response.ok) {
            return {
                valida: false,
                messaggio: data.message || 'Errore durante la verifica',
                status: response.status,
                dati: data
            };
        }

        const valida = data.state === 'deliverable';

        return {
            valida: valida,
            stato: data.state,
            score: data.score,
            motivo: data.reason,
            suggerimento: data.did_you_mean,
            messaggio: valida ? 'Email valida' : 'Email non valida o non sicura',
            dati: data
        };

    } catch (error) {
        return {
            valida: false,
            messaggio: 'Errore di rete durante la verifica',
            errore: error.message,
            dati: null
        };
    }
}

function setupEmailableValidation(campoId, formId) {
    const campo = document.getElementById(campoId);
    const form  = document.getElementById(formId);
    if (!campo || !form) return;
    if (campo.dataset.emailableInit) return;
    campo.dataset.emailableInit = '1';

    let emailValida = null;

    function setStato(stato) {
        switch (stato) {
            case 'errore':
                campo.style.backgroundColor = '#f8d7da';
                campo.style.borderColor     = '#dc3545';
                break;
            case 'ok':
            default:
                campo.style.backgroundColor = '';
                campo.style.borderColor     = '';
        }
    }

    async function runValidazione() {
        const val = campo.value.trim();
        if (!val) { emailValida = null; setStato(null); return; }

        const ris = await verificaEmailCampo(campoId);

        if (ris.riprovare || ris.errore) {
            emailValida = true;
            setStato(null);
            return;
        }

        if (ris.valida) {
            emailValida = true;
            setStato('ok');
        } else {
            emailValida = false;
            setStato('errore');
        }
    }

    campo.addEventListener('blur', runValidazione);

    form.addEventListener('submit', function (e) {
        if (emailValida === false) {
            e.preventDefault();
            setStato('errore');
            campo.focus();
        } else if (emailValida === null && campo.value.trim()) {
            e.preventDefault();
            runValidazione().then(function () {
                if (emailValida !== false) form.submit();
                else campo.focus();
            });
        }
    });

    const nativeSubmit = HTMLFormElement.prototype.submit.bind(form);
    form.submit = function () {
        if (emailValida === false) {
            setStato('errore');
            campo.focus();
            return;
        }
        if (emailValida === null && campo.value.trim()) {
            runValidazione().then(function () {
                if (emailValida !== false) nativeSubmit();
                else campo.focus();
            });
            return;
        }
        nativeSubmit();
    };
}

document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('input[type="email"]').forEach(function(emailField) {
        if (!emailField.id) return;
        var form = emailField.closest('form');
        if (!form || !form.id) return;
        setupEmailableValidation(emailField.id, form.id);
    });
});
</script>
